# systemd unit for PromptPace.
# Install: sudo cp deploy/promptpace.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now promptpace
[Unit]
Description=PromptPace typing-rhythm web app
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=promptpace
Group=nginx
WorkingDirectory=/opt/promptpace
# PROMPTPACE_DATABASE_URL (with the role's password) lives here, readable by root and this
# service only. Format: deploy/promptpace.env.example. Setup: README, "Deploy", step 3.
EnvironmentFile=/etc/promptpace/promptpace.env
Environment=PROMPTPACE_SECURE_COOKIES=1
# Listens on a unix socket that nginx proxies to. `--proxy-headers` trusts
# X-Forwarded-* from nginx so client IPs and https scheme are correct.
ExecStart=/opt/promptpace/.venv/bin/uvicorn app.main:app \
    --uds /run/promptpace/uvicorn.sock \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips="*" \
    --no-server-header
RuntimeDirectory=promptpace
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
